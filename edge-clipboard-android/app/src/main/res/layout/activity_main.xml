<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="32dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/main_intro"
            android:textColor="@color/sub"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <Switch
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/toggle"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <Button
                android:id="@+id/open_panel"
                style="@style/PillButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:text="@string/open_panel" />
        </LinearLayout>

        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/permissions" />

        <LinearLayout
            android:id="@+id/permission_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical" />

        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/handle_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/width" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:id="@+id/width_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sub" />
            </LinearLayout>
            <SeekBar android:id="@+id/width_bar" android:layout_width="match_parent" android:layout_height="48dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/height" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:id="@+id/height_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sub" />
            </LinearLayout>
            <SeekBar android:id="@+id/height_bar" android:layout_width="match_parent" android:layout_height="48dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/opacity" android:textColor="@color/text" android:textSize="16sp" />
                <TextView android:id="@+id/alpha_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sub" />
            </LinearLayout>
            <SeekBar android:id="@+id/alpha_bar" android:layout_width="match_parent" android:layout_height="48dp" />

            <Button
                android:id="@+id/reset_size"
                style="@android:style/Widget.Material.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:text="@string/reset_size"
                android:textAllCaps="false"
                android:textColor="@color/accent" />
        </LinearLayout>

        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coloros_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="@string/coloros_tips"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
