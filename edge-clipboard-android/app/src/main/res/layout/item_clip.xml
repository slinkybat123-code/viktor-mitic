<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:orientation="vertical">

    <!-- Preview: tap opens the full clip, touch and hold shows Pin / Delete -->
    <FrameLayout
        android:id="@+id/clip_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_clip_top"
        android:foreground="@drawable/fg_ripple_top"
        android:minHeight="72dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/clip_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="5"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/clip_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/image_clip"
            android:maxHeight="220dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/clip_pin_badge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pin"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/clip_actions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:animateLayoutChanges="true"
        android:background="@color/card"
        android:visibility="gone">

        <TextView
            android:id="@+id/clip_pin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_round_btn"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clip_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_round_btn"
            android:gravity="center"
            android:text="@string/delete"
            android:textColor="@color/danger"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/clip_copy"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_copy"
        android:gravity="center"
        android:text="@string/copy"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
