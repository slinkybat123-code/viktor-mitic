<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22888888">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/card" />
                    <corners android:radius="20dp" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/card" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="20dp" /></shape>
    </item>
</ripple>
